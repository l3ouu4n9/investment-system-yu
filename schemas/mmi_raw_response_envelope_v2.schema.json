{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/mmi_raw_response_envelope_v2.schema.json",
  "title": "MMI raw response envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "report_only",
    "authority_effect",
    "manual_handoff_required",
    "grounded_prompt_artifact_identity_sha256",
    "raw_response_byte_length",
    "raw_response_sha256",
    "raw_response_base64",
    "raw_response_envelope_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mmi_raw_response_envelope_v2"
    },
    "artifact_kind": {
      "const": "MMI_RAW_RESPONSE_ENVELOPE"
    },
    "report_only": {
      "const": true
    },
    "authority_effect": {
      "const": "NONE"
    },
    "manual_handoff_required": {
      "const": true
    },
    "grounded_prompt_artifact_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_response_byte_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "raw_response_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_response_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 349528,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "raw_response_envelope_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
