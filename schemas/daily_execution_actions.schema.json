{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "as_of",
    "workflow",
    "scope",
    "weekly_sources",
    "actions",
    "blocked_items",
    "portfolio_snapshot_existing_buy_open_orders_patch",
    "operator_notes"
  ],
  "properties": {
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "workflow": {
      "const": "daily_execution_check"
    },
    "scope": {
      "const": "execution_only"
    },
    "weekly_sources": {
      "type": "object",
      "required": [
        "audited_decision_packet_path",
        "template4_orders_path",
        "order_state_export_path"
      ],
      "properties": {
        "audited_decision_packet_path": {
          "type": "string",
          "minLength": 1
        },
        "template4_orders_path": {
          "type": "string",
          "minLength": 1
        },
        "order_state_export_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action_item"
      }
    },
    "blocked_items": {
      "type": "array",
      "items": {}
    },
    "portfolio_snapshot_existing_buy_open_orders_patch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "side",
          "patch_type",
          "paste_target_section",
          "paste_instruction",
          "header",
          "row_text",
          "operator_confirmation_required",
          "not_live_broker_truth_until_submitted",
          "source_evidence"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": ["BUY"]
          },
          "patch_type": {
            "type": "string",
            "enum": [
              "NEW_BUY_ORDER",
              "REPLACE_EXISTING_BUY_ORDER"
            ]
          },
          "paste_target_section": {
            "type": "string",
            "enum": [
              "PORTFOLIO_SNAPSHOT.existing_buy_open_orders_summary"
            ]
          },
          "paste_instruction": {
            "type": "string",
            "minLength": 1
          },
          "header": {
            "type": "string",
            "const": "TICKER | budget | compiled_open_order_notional(optional) | residual_cash_not_allocated(optional) | template_id | anchor_baseline_last_close | anchor_price_asof | last_refresh_date_et(optional) | highest_live_limit(optional) | lowest_live_limit(optional) | live_step_count(optional) | live_order_steps_summary(optional) | live_order_qtys_summary(optional)"
          },
          "row_text": {
            "type": "string",
            "minLength": 1
          },
          "operator_confirmation_required": {
            "type": "boolean",
            "const": true
          },
          "not_live_broker_truth_until_submitted": {
            "type": "boolean",
            "const": true
          },
          "source_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operator_notes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/operator_note"
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "action_item": {
      "type": "object",
      "required": [
        "ticker",
        "side",
        "action",
        "reason_code",
        "execution_only",
        "weekly_intent_preserved",
        "no_new_thesis",
        "no_ranking_change",
        "no_budget_increase",
        "source_evidence",
        "replace_packet"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": ["BUY", "SELL"]
        },
        "action": {
          "enum": [
            "KEEP",
            "REPLACE",
            "CANCEL",
            "HOLD_FOR_WEEKLY_REVIEW",
            "DATA_GAP"
          ]
        },
        "reason_code": {
          "enum": [
            "execution_drift_within_tolerance",
            "execution_reanchor_required",
            "execution_state_cancel_required",
            "weekly_review_required",
            "daily_market_data_gap",
            "live_order_state_data_gap",
            "weekly_source_data_gap",
            "operator_override_hold",
            "operator_override_cancel",
            "manual_smoke_test_keep"
          ]
        },
        "execution_only": {
          "const": true
        },
        "weekly_intent_preserved": {
          "type": "boolean"
        },
        "no_new_thesis": {
          "const": true
        },
        "no_ranking_change": {
          "const": true
        },
        "no_budget_increase": {
          "const": true
        },
        "source_evidence": {
          "type": "string",
          "minLength": 1
        },
        "replace_packet": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/replace_packet"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "REPLACE"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "replace_packet": {
                "$ref": "#/$defs/replace_packet"
              }
            }
          },
          "else": {
            "properties": {
              "replace_packet": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["KEEP", "REPLACE", "CANCEL"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "weekly_intent_preserved": {
                "const": true
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "operator_note": {
      "type": "object",
      "required": [
        "ticker",
        "note_type",
        "message"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "note_type": {
          "enum": [
            "near_anchor_drift_edge",
            "near_highest_live_limit_edge",
            "repeated_near_edge_weekly_review",
            "lowest_live_limit_evidence_only",
            "core_underdeployment_watch"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "replace_packet": {
      "type": "object",
      "required": [
        "ticker",
        "same_ticker",
        "remaining_budget_before",
        "remaining_budget_after",
        "budget_delta",
        "preserve_weekly_role",
        "preserve_event_binding",
        "replacement_reason",
        "proposed_anchor_source",
        "notes_for_replace_packet_synthesis"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "same_ticker": {
          "const": true
        },
        "remaining_budget_before": {
          "type": "number"
        },
        "remaining_budget_after": {
          "type": "number"
        },
        "budget_delta": {
          "const": 0
        },
        "preserve_weekly_role": {
          "const": true
        },
        "preserve_event_binding": {
          "const": true
        },
        "replacement_reason": {
          "type": "string",
          "minLength": 1
        },
        "proposed_anchor_source": {
          "type": "string",
          "minLength": 1
        },
        "notes_for_replace_packet_synthesis": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
