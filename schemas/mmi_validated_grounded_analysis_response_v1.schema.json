{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/mmi_validated_grounded_analysis_response_v1.schema.json",
  "title": "MMI validated grounded-analysis response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "report_only",
    "authority_effect",
    "manual_handoff_required",
    "raw_response_envelope_identity_sha256",
    "response_payload",
    "validated_grounded_analysis_response_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mmi_validated_grounded_analysis_response_v1"
    },
    "artifact_kind": {
      "const": "MMI_VALIDATED_GROUNDED_ANALYSIS_RESPONSE"
    },
    "report_only": {
      "const": true
    },
    "authority_effect": {
      "const": "NONE"
    },
    "manual_handoff_required": {
      "const": true
    },
    "raw_response_envelope_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_payload": {
      "$ref": "#/$defs/response_payload"
    },
    "validated_grounded_analysis_response_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "response_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_schema_version",
        "prompt_context_binding_sha256",
        "analysis_status",
        "evidence_observations",
        "risks",
        "uncertainties",
        "contradictions",
        "research_questions",
        "summary"
      ],
      "properties": {
        "response_schema_version": {
          "const": "mmi_grounded_analysis_response_v1"
        },
        "prompt_context_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "analysis_status": {
          "enum": [
            "QUALITATIVE_ANALYSIS_PROVIDED",
            "INSUFFICIENT_EVIDENCE",
            "EVIDENCE_CONTRADICTIONS_IDENTIFIED"
          ]
        },
        "evidence_observations": {
          "$ref": "#/$defs/analysis_items_12"
        },
        "risks": {
          "$ref": "#/$defs/analysis_items_12"
        },
        "uncertainties": {
          "$ref": "#/$defs/analysis_items_12"
        },
        "contradictions": {
          "$ref": "#/$defs/analysis_items_8"
        },
        "research_questions": {
          "$ref": "#/$defs/analysis_items_12"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        }
      }
    },
    "analysis_items_12": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/analysis_item"
      }
    },
    "analysis_items_8": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/analysis_item"
      }
    },
    "analysis_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "references",
        "hypothesis"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "hypothesis": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "references",
        "hypothesis"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "hypothesis": {
          "type": "boolean"
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "evidence_reference": {
      "oneOf": [
        {
          "enum": [
            "VIEW.EVALUATION_TIMESTAMP",
            "VIEW.COMPLETENESS_STATUS",
            "POLICY.AS_OF_DATE",
            "POLICY.METHOD",
            "POLICY.BENCHMARK.0001",
            "POLICY.EXTENDED_ACTIVATION_STATUS",
            "POLICY.INSTRUMENT_AVAILABILITY_STATUS",
            "POLICY.TARGET_WEIGHTS_ABSENCE_REASON",
            "PORTFOLIO.PRESENCE_STATUS",
            "PORTFOLIO.SOURCE_DATE",
            "PORTFOLIO.OPEN_BUY_STATUS",
            "PORTFOLIO.COVERAGE.HOLDINGS",
            "PORTFOLIO.COVERAGE.CASH",
            "PORTFOLIO.COVERAGE.DEPLOYABLE_CASH",
            "PORTFOLIO.COVERAGE.OPEN_SELLS",
            "PORTFOLIO.COVERAGE.TAX_LOTS",
            "PORTFOLIO.COVERAGE.HOLDING_DATES",
            "PORTFOLIO.COVERAGE.GAINS_LOSSES",
            "PORTFOLIO.COVERAGE.WEIGHTS",
            "PORTFOLIO.COVERAGE.NAV_CONCENTRATION",
            "PORTFOLIO.COVERAGE.LOOK_THROUGH_EXPOSURE"
          ]
        },
        {
          "type": "string",
          "pattern": "^POLICY\\.INSTRUMENT\\.(?:000[1-9]|00[1-9][0-9]|01[0-9]{2}|02[0-4][0-9]|025[0-6])(?![\\s\\S])"
        },
        {
          "type": "string",
          "pattern": "^PORTFOLIO\\.OBSERVATION\\.(?:000[1-9]|00[1-9][0-9]|01[0-9]{2}|02[0-4][0-9]|025[0-6])(?![\\s\\S])"
        },
        {
          "type": "string",
          "pattern": "^LIMITATION\\.00(?:0[1-9]|1[0-4])(?![\\s\\S])"
        }
      ]
    }
  }
}
