{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/mmi_h1_prepared_handoff_v1.schema.json",
  "title": "MMI H1 prepared handoff v1",
  "description": "Closed report-only envelope for one dormant manual H1 prepared handoff. The embedded grounded prompt is an opaque identity-bearing mapping whose source-bound reconstruction remains owned by the consuming workflow. A null portfolio_snapshot_source_sha256 records a proven absent code-owned portfolio source and is never a digest sentinel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "report_only",
    "authority_effect",
    "evaluation_timestamp_utc",
    "strategy_settings_source_sha256",
    "portfolio_snapshot_source_sha256",
    "grounded_prompt",
    "prepared_handoff_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mmi_h1_prepared_handoff_v1"
    },
    "artifact_kind": {
      "const": "MMI_H1_PREPARED_HANDOFF"
    },
    "report_only": {
      "const": true
    },
    "authority_effect": {
      "const": "NONE"
    },
    "evaluation_timestamp_utc": {
      "$ref": "#/$defs/canonical_timestamp"
    },
    "strategy_settings_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "portfolio_snapshot_source_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "grounded_prompt": {
      "$ref": "#/$defs/opaque_mapping"
    },
    "prepared_handoff_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "opaque_mapping": {
      "type": "object"
    }
  }
}
