{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/weekly_shadow_01_run_summary.schema.json",
  "title": "WEEKLY-SHADOW-01 Run Summary v1",
  "description": "Entirely code-owned. Every run/validation/publication status is code-owned. A blocked summary must not contain unvalidated analyst findings; the raw LLM response is never treated as a run summary.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_status",
    "validation_status",
    "publication_status",
    "blocking_reason_codes",
    "report_identity_sha256",
    "negative_authority_profile",
    "run_summary_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "weekly_shadow_01_run_summary_v1"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "run_status": {"enum": ["ANALYSIS_COMPLETE", "BLOCKED"]},
    "validation_status": {"enum": ["VALID", "INVALID"]},
    "publication_status": {"enum": ["NOT_ATTEMPTED", "PUBLISHED", "FAILED"]},
    "blocking_reason_codes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blocking_reason_code"}
    },
    "report_identity_sha256": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "negative_authority_profile": {"$ref": "#/$defs/negative_authority_profile"},
    "run_summary_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"run_status": {"const": "ANALYSIS_COMPLETE"}}, "required": ["run_status"]},
      "then": {
        "properties": {
          "validation_status": {"const": "VALID"},
          "publication_status": {"const": "PUBLISHED"},
          "blocking_reason_codes": {"maxItems": 0},
          "report_identity_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"run_status": {"const": "BLOCKED"}}, "required": ["run_status"]},
      "then": {
        "properties": {
          "publication_status": {"enum": ["NOT_ATTEMPTED", "FAILED"]},
          "blocking_reason_codes": {"minItems": 1},
          "report_identity_sha256": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "blocking_reason_code": {
      "enum": [
        "WS01_BR_SOURCE_GENERATION_INVALID",
        "WS01_BR_SOURCE_ARTIFACT_SET_MISMATCH",
        "WS01_BR_SOURCE_VERSION_UNSUPPORTED",
        "WS01_BR_SOURCE_READ_UNSTABLE",
        "WS01_BR_SOURCE_BINDING_MISMATCH",
        "WS01_BR_PACKAGE_CONSTRUCTION_FAILED",
        "WS01_BR_RESOURCE_BOUND_EXCEEDED",
        "WS01_BR_RESPONSE_MISSING",
        "WS01_BR_RESPONSE_UNREADABLE",
        "WS01_BR_RESPONSE_OVERSIZED",
        "WS01_BR_RESPONSE_PARSE_FAILED",
        "WS01_BR_RESPONSE_DUPLICATE_KEY",
        "WS01_BR_RESPONSE_SCHEMA_INVALID",
        "WS01_BR_RUN_BINDING_MISMATCH",
        "WS01_BR_PACKAGE_BINDING_MISMATCH",
        "WS01_BR_PROMPT_TEMPLATE_BINDING_MISMATCH",
        "WS01_BR_SOURCE_GENERATION_BINDING_MISMATCH",
        "WS01_BR_ARTIFACT_ECHO_INCOMPLETE",
        "WS01_BR_ARTIFACT_ECHO_UNEXPECTED",
        "WS01_BR_EVIDENCE_ECHO_INCOMPLETE",
        "WS01_BR_EVIDENCE_ECHO_UNEXPECTED",
        "WS01_BR_EVIDENCE_REFERENCE_INVALID",
        "WS01_BR_PROHIBITED_KEY",
        "WS01_BR_PROHIBITED_INTENT",
        "WS01_BR_CROSS_FIELD_INVALID",
        "WS01_BR_REPORT_CONSTRUCTION_FAILED",
        "WS01_BR_REPORT_IDENTITY_FAILURE",
        "WS01_BR_PUBLICATION_FAILED",
        "WS01_BR_PUBLICATION_CONFLICT",
        "WS01_BR_PUBLICATION_AMBIGUOUS",
        "WS01_BR_IMMUTABLE_VERIFICATION_FAILED",
        "WS01_BR_INTERNAL_INVARIANT_FAILURE"
      ]
    },
    "negative_authority_profile": {
      "type": "object",
      "required": [
        "authority_effect",
        "permission_effect",
        "approval_eligible",
        "precompile_eligible",
        "order_eligible",
        "portfolio_effect",
        "order_path_effect",
        "execution_authority"
      ],
      "properties": {
        "authority_effect": {"const": "none"},
        "permission_effect": {"const": "none"},
        "approval_eligible": {"const": false},
        "precompile_eligible": {"const": false},
        "order_eligible": {"const": false},
        "portfolio_effect": {"const": "none"},
        "order_path_effect": {"const": "none"},
        "execution_authority": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
