{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "snapshot_type", "run_timestamp_et", "tickers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_type": {"const": "ANCHOR_DRIFT_SNAPSHOT"},
    "run_timestamp_et": {"type": "string", "minLength": 1},
    "tickers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "side",
          "old_baseline",
          "new_baseline",
          "price_asof",
          "atr_pct",
          "signed_drift_pct",
          "drift_pct",
          "up_drift_pct",
          "down_drift_pct",
          "keep_threshold_pct",
          "mini_threshold_pct",
          "anchor_decision_mechanical",
          "age_days_since_last_refresh",
          "age_upgrade_applied",
          "data_gap",
          "data_gap_reason"
        ],
        "properties": {
          "ticker": {"type": "string", "minLength": 1},
          "side": {"type": "string", "minLength": 1},
          "old_baseline": {"type": ["number", "null"]},
          "new_baseline": {"type": ["number", "null"]},
          "price_asof": {"type": ["string", "null"]},
          "atr_pct": {"type": ["number", "null"]},
          "signed_drift_pct": {"type": ["number", "null"]},
          "drift_pct": {"type": ["number", "null"]},
          "up_drift_pct": {"type": ["number", "null"]},
          "down_drift_pct": {"type": ["number", "null"]},
          "keep_threshold_pct": {"type": "number"},
          "mini_threshold_pct": {"type": "number"},
          "anchor_decision_mechanical": {"type": "string", "minLength": 1},
          "age_days_since_last_refresh": {"type": "integer"},
          "age_upgrade_applied": {"type": "boolean"},
          "data_gap": {"type": "boolean"},
          "data_gap_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
