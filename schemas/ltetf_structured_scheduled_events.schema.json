{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/ltetf_structured_scheduled_events.schema.json",
  "title": "LTETF Structured Scheduled Events v1",
  "description": "Closed neutral scheduled-event content contract. Event importance and investment relevance are outside this contract.",
  "type": "object",
  "required": ["schema_version", "evidence_class", "subject_identity_sha256", "records", "authority_effect"],
  "properties": {
    "schema_version": {"const": "ltetf_structured_scheduled_events_v1"},
    "evidence_class": {"const": "structured_scheduled_events"},
    "subject_identity_sha256": {"$ref": "#/$defs/sha256"},
    "records": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/event_record"}
    },
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "event_record": {
      "type": "object",
      "required": [
        "event_id",
        "event_identity_profile_id",
        "event_type_id",
        "event_type_identity_profile_id",
        "event_state",
        "published_at_utc",
        "scheduled_at_utc"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "event_identity_profile_id": {"const": "ltetf_event_identity_profile_v1"},
        "event_type_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+){1,7}$"
        },
        "event_type_identity_profile_id": {"const": "ltetf_event_type_identity_profile_v1"},
        "event_state": {"enum": ["scheduled", "postponed", "cancelled", "completed"]},
        "published_at_utc": {"$ref": "#/$defs/timestamp_utc"},
        "scheduled_at_utc": {"$ref": "#/$defs/timestamp_utc"}
      },
      "additionalProperties": false
    }
  }
}
