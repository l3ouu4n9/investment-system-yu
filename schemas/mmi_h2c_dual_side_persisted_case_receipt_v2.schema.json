{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/mmi_h2c_dual_side_persisted_case_receipt_v2.schema.json",
  "title": "MMI H2c dual-side persisted-case receipt v2",
  "description": "Closed report-only identity receipt for later deterministic consumption of one prepared H2c case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "consumption_contract_version",
    "report_only",
    "authority_effect",
    "evaluation_timestamp_utc",
    "prepared_case_identity_sha256",
    "case_evidence_bundle_identity_sha256",
    "comparison_report_identity_sha256",
    "strategy_settings_source_record_identity_sha256",
    "portfolio_snapshot_source_record_identity_sha256",
    "h1_prompt_sha256",
    "legacy_prompt_sha256",
    "h1_operator_supplied_response_sha256",
    "legacy_operator_supplied_response_sha256",
    "receipt_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mmi_h2c_dual_side_persisted_case_receipt_v2"
    },
    "artifact_kind": {
      "const": "MMI_H2C_DUAL_SIDE_PERSISTED_CASE_RECEIPT"
    },
    "consumption_contract_version": {
      "const": "mmi_h2c_persisted_case_consume_v1"
    },
    "report_only": {
      "const": true
    },
    "authority_effect": {
      "const": "NONE"
    },
    "evaluation_timestamp_utc": {
      "$ref": "#/$defs/canonical_timestamp"
    },
    "prepared_case_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_evidence_bundle_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "comparison_report_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "strategy_settings_source_record_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "portfolio_snapshot_source_record_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "h1_prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "legacy_prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "h1_operator_supplied_response_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "legacy_operator_supplied_response_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    }
  }
}
