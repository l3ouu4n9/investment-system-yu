{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/ltetf_trusted_evaluation_epoch.schema.json",
  "title": "LTETF Trusted Deterministic Evaluation Epoch v1",
  "description": "Identity-bound deterministic evaluation epoch. It is not a current real-world time claim, has no self-freshness claim, and confers no authority.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_class",
    "subject_identity_sha256",
    "evaluation_epoch_utc",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "ltetf_trusted_evaluation_epoch_v1"},
    "evidence_class": {"const": "trusted_evaluation_epoch"},
    "subject_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_epoch_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
