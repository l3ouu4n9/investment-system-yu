{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_type",
    "run_timestamp_et",
    "execution_date_et",
    "market_data_target_close_date_et",
    "close_time_zone",
    "display_time_zone",
    "primary_source",
    "fallback_source_for_last_close_and_price_asof_only",
    "holiday_aware_close_resolution",
    "tickers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_type": {"const": "MARKET_DATA_SNAPSHOT"},
    "run_timestamp_et": {"type": "string", "minLength": 1},
    "execution_date_et": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "market_data_target_close_date_et": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "close_time_zone": {"type": "string", "minLength": 1},
    "display_time_zone": {"type": "string", "minLength": 1},
    "primary_source": {"type": "string", "minLength": 1},
    "fallback_source_for_last_close_and_price_asof_only": {"type": "string", "minLength": 1},
    "holiday_aware_close_resolution": {"type": "boolean"},
    "tickers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "last_close",
          "price_asof",
          "atr_20_30d_pct",
          "ma50",
          "ma200",
          "avg_volume_3m",
          "last_close_source",
          "price_asof_source",
          "technicals_source",
          "retrieved_at_utc",
          "same_day_close_required",
          "freshness_ok",
          "data_gap",
          "data_gap_reason",
          "notes"
        ],
        "properties": {
          "ticker": {"type": "string", "minLength": 1},
          "last_close": {"type": ["number", "null"]},
          "price_asof": {"type": ["string", "null"]},
          "atr_20_30d_pct": {"type": ["number", "null"]},
          "ma50": {"type": ["number", "null"]},
          "ma200": {"type": ["number", "null"]},
          "avg_volume_3m": {"type": ["integer", "null"]},
          "last_close_source": {"type": "string", "minLength": 1},
          "price_asof_source": {"type": "string", "minLength": 1},
          "technicals_source": {"type": "string", "minLength": 1},
          "retrieved_at_utc": {"type": ["string", "null"]},
          "same_day_close_required": {"type": "boolean"},
          "freshness_ok": {"type": "boolean"},
          "data_gap": {"type": "boolean"},
          "data_gap_reason": {"type": ["string", "null"]},
          "notes": {
            "type": "array",
            "items": {}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
