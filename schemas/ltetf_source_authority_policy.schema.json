{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/ltetf_source_authority_policy.schema.json",
  "title": "LTETF Source Authority Policy v1",
  "description": "Closed operator-authored source-class policy payload. This payload cannot accept itself and has no activation, permission, truth, investment, publication, order, broker, or execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_type",
    "authority_effect",
    "policy_content",
    "policy_content_identity_sha256",
    "policy_artifact_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ltetf_source_authority_policy_v1"},
    "policy_type": {"const": "source_authority_policy"},
    "authority_effect": {"const": "none"},
    "policy_content": {"$ref": "#/$defs/policy_content"},
    "policy_content_identity_sha256": {"$ref": "#/$defs/sha256"},
    "policy_artifact_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_content": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version",
        "policy_schema_identity_sha256",
        "policy_contract_identity_sha256",
        "rules"
      ],
      "properties": {
        "policy_id": {"const": "ltetf_source_authority_policy"},
        "policy_version": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,126}_v[1-9][0-9]*$",
          "maxLength": 128
        },
        "policy_schema_identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy_contract_identity_sha256": {"$ref": "#/$defs/sha256"},
        "rules": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/trusted_epoch_rule"},
            {"$ref": "#/$defs/market_metrics_rule"},
            {"$ref": "#/$defs/scheduled_events_rule"},
            {"$ref": "#/$defs/prior_thesis_rule"}
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "allowed_source_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["operator_attested", "registered_external", "repository_derived"]
      }
    },
    "trusted_epoch_rule": {
      "type": "object",
      "required": ["evidence_class", "allowed_source_classes", "registry_required"],
      "properties": {
        "evidence_class": {"const": "trusted_evaluation_epoch"},
        "allowed_source_classes": {"$ref": "#/$defs/allowed_source_classes"},
        "registry_required": {"const": true}
      },
      "additionalProperties": false
    },
    "market_metrics_rule": {
      "type": "object",
      "required": ["evidence_class", "allowed_source_classes", "registry_required"],
      "properties": {
        "evidence_class": {"const": "structured_market_metrics"},
        "allowed_source_classes": {"$ref": "#/$defs/allowed_source_classes"},
        "registry_required": {"const": true}
      },
      "additionalProperties": false
    },
    "scheduled_events_rule": {
      "type": "object",
      "required": ["evidence_class", "allowed_source_classes", "registry_required"],
      "properties": {
        "evidence_class": {"const": "structured_scheduled_events"},
        "allowed_source_classes": {"$ref": "#/$defs/allowed_source_classes"},
        "registry_required": {"const": true}
      },
      "additionalProperties": false
    },
    "prior_thesis_rule": {
      "type": "object",
      "required": ["evidence_class", "allowed_source_classes", "registry_required"],
      "properties": {
        "evidence_class": {"const": "prior_thesis_continuity"},
        "allowed_source_classes": {"$ref": "#/$defs/allowed_source_classes"},
        "registry_required": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
