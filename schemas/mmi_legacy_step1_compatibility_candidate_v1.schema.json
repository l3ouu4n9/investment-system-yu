{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/mmi_legacy_step1_compatibility_candidate_v1.schema.json",
  "title": "MMI legacy Step 1 semantic compatibility candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "compiler_contract_version",
    "report_only",
    "authority_effect",
    "provenance",
    "analysis_status",
    "ordered_instrument_assessments",
    "evidence_observations",
    "risks",
    "uncertainties",
    "contradictions",
    "research_questions",
    "summary",
    "source_capability_statuses",
    "legacy_step1_compatibility_candidate_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mmi_legacy_step1_compatibility_candidate_v1"
    },
    "artifact_kind": {
      "const": "MMI_LEGACY_STEP1_COMPATIBILITY_CANDIDATE"
    },
    "compiler_contract_version": {
      "const": "mmi_legacy_step1_compatibility_compiler_v1"
    },
    "report_only": {
      "const": true
    },
    "authority_effect": {
      "const": "NONE"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "analysis_status": {
      "enum": [
        "QUALITATIVE_ANALYSIS_PROVIDED",
        "INSUFFICIENT_EVIDENCE",
        "EVIDENCE_CONTRADICTIONS_IDENTIFIED"
      ]
    },
    "ordered_instrument_assessments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/instrument_assessment"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "policy_role": {
                "const": "CORE"
              }
            },
            "required": [
              "policy_role"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "policy_role": {
                "const": "SATELLITE"
              }
            },
            "required": [
              "policy_role"
            ]
          },
          "minContains": 1
        }
      ]
    },
    "evidence_observations": {
      "$ref": "#/$defs/analysis_items_12"
    },
    "risks": {
      "$ref": "#/$defs/analysis_items_12"
    },
    "uncertainties": {
      "$ref": "#/$defs/analysis_items_12"
    },
    "contradictions": {
      "$ref": "#/$defs/analysis_items_8"
    },
    "research_questions": {
      "$ref": "#/$defs/analysis_items_12"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "source_capability_statuses": {
      "$ref": "#/$defs/source_capability_statuses"
    },
    "legacy_step1_compatibility_candidate_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,15}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyst_visible_evidence_view_identity_sha256",
        "validated_grounded_analysis_response_identity_sha256"
      ],
      "properties": {
        "analyst_visible_evidence_view_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validated_grounded_analysis_response_identity_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "instrument_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "policy_role",
        "evidence_status",
        "rationale_12m_plus",
        "references"
      ],
      "properties": {
        "ticker": {
          "$ref": "#/$defs/ticker"
        },
        "policy_role": {
          "enum": [
            "CORE",
            "SATELLITE",
            "APPROVED_EXTENDED"
          ]
        },
        "evidence_status": {
          "enum": [
            "EVIDENCE_SUPPORTED",
            "INSUFFICIENT_EVIDENCE",
            "CONTRADICTED",
            "UNAVAILABLE"
          ]
        },
        "rationale_12m_plus": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          ]
        },
        "references": {
          "$ref": "#/$defs/instrument_references"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": {
                "const": "UNAVAILABLE"
              }
            },
            "required": [
              "evidence_status"
            ]
          },
          "then": {
            "properties": {
              "rationale_12m_plus": {
                "type": "null"
              },
              "references": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "rationale_12m_plus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "analysis_items_12": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/analysis_item"
      }
    },
    "analysis_items_8": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/analysis_item"
      }
    },
    "analysis_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "references",
        "hypothesis"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "hypothesis": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "references",
        "hypothesis"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "hypothesis": {
          "type": "boolean"
        }
      }
    },
    "instrument_references": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "source_capability_statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_associations_status",
        "scheduled_events_status",
        "regime_inputs_status",
        "target_weights_absence_reason"
      ],
      "properties": {
        "anchor_associations_status": {
          "const": "UNAVAILABLE"
        },
        "scheduled_events_status": {
          "const": "UNAVAILABLE"
        },
        "regime_inputs_status": {
          "const": "UNAVAILABLE"
        },
        "target_weights_absence_reason": {
          "const": "POLICY_METHOD_HAS_NO_TARGET_WEIGHTS"
        }
      }
    },
    "evidence_reference": {
      "oneOf": [
        {
          "enum": [
            "VIEW.EVALUATION_TIMESTAMP",
            "VIEW.COMPLETENESS_STATUS",
            "POLICY.AS_OF_DATE",
            "POLICY.METHOD",
            "POLICY.BENCHMARK.0001",
            "POLICY.EXTENDED_ACTIVATION_STATUS",
            "POLICY.INSTRUMENT_AVAILABILITY_STATUS",
            "POLICY.TARGET_WEIGHTS_ABSENCE_REASON",
            "PORTFOLIO.PRESENCE_STATUS",
            "PORTFOLIO.SOURCE_DATE",
            "PORTFOLIO.OPEN_BUY_STATUS",
            "PORTFOLIO.COVERAGE.HOLDINGS",
            "PORTFOLIO.COVERAGE.CASH",
            "PORTFOLIO.COVERAGE.DEPLOYABLE_CASH",
            "PORTFOLIO.COVERAGE.OPEN_SELLS",
            "PORTFOLIO.COVERAGE.TAX_LOTS",
            "PORTFOLIO.COVERAGE.HOLDING_DATES",
            "PORTFOLIO.COVERAGE.GAINS_LOSSES",
            "PORTFOLIO.COVERAGE.WEIGHTS",
            "PORTFOLIO.COVERAGE.NAV_CONCENTRATION",
            "PORTFOLIO.COVERAGE.LOOK_THROUGH_EXPOSURE"
          ]
        },
        {
          "type": "string",
          "pattern": "^POLICY\\.INSTRUMENT\\.(?:000[1-9]|00[1-9][0-9]|01[0-9]{2}|02[0-4][0-9]|025[0-6])(?![\\s\\S])"
        },
        {
          "type": "string",
          "pattern": "^PORTFOLIO\\.OBSERVATION\\.(?:000[1-9]|00[1-9][0-9]|01[0-9]{2}|02[0-4][0-9]|025[0-6])(?![\\s\\S])"
        },
        {
          "type": "string",
          "pattern": "^LIMITATION\\.00(?:0[1-9]|1[0-4])(?![\\s\\S])"
        }
      ]
    }
  }
}
