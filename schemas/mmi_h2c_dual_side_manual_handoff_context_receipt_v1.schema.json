{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/mmi_h2c_dual_side_manual_handoff_context_receipt_v1.schema.json",
  "title": "MMI H2c dual-side manual handoff context receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "capture_contract_version",
    "report_only",
    "authority_effect",
    "live_context_validated_at_capture",
    "operator_h1_response_bytes_bound_at_capture",
    "operator_legacy_response_bytes_bound_at_capture",
    "provider_origin_authentication",
    "evaluation_timestamp_utc",
    "strategy_settings_source_record_identity_sha256",
    "portfolio_snapshot_source_record_identity_sha256",
    "legacy_prompt_template_sha256",
    "legacy_prompt_sha256",
    "comparison_report_identity_sha256",
    "receipt_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "mmi_h2c_dual_side_manual_handoff_context_receipt_v1"
    },
    "artifact_kind": {
      "const": "MMI_H2C_DUAL_SIDE_MANUAL_HANDOFF_CONTEXT_RECEIPT"
    },
    "capture_contract_version": {
      "const": "mmi_h2c_manual_capture_v1"
    },
    "report_only": {
      "const": true
    },
    "authority_effect": {
      "const": "NONE"
    },
    "live_context_validated_at_capture": {
      "const": true
    },
    "operator_h1_response_bytes_bound_at_capture": {
      "const": true
    },
    "operator_legacy_response_bytes_bound_at_capture": {
      "const": true
    },
    "provider_origin_authentication": {
      "const": "NOT_ESTABLISHED"
    },
    "evaluation_timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "strategy_settings_source_record_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "portfolio_snapshot_source_record_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "legacy_prompt_template_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "legacy_prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "comparison_report_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
