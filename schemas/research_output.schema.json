{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "validation_summary"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "validation_summary": {
      "type": "object",
      "required": ["passed", "fail_reasons", "auto_fixes_applied"],
      "properties": {
        "passed": {"type": "boolean"},
        "fail_reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "auto_fixes_applied": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
