{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-system.local/schemas/ltetf_authorized_source_registry.schema.json",
  "title": "LTETF Authorized Source Registry v1",
  "description": "Closed operator-authored source identity and provenance registry. Registration does not prove source bytes, factual truth, activation, permission, or investment sufficiency.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_type",
    "authority_effect",
    "policy_content",
    "policy_content_identity_sha256",
    "policy_artifact_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ltetf_authorized_source_registry_v1"},
    "policy_type": {"const": "authorized_source_registry"},
    "authority_effect": {"const": "none"},
    "policy_content": {"$ref": "#/$defs/policy_content"},
    "policy_content_identity_sha256": {"$ref": "#/$defs/sha256"},
    "policy_artifact_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,126}_v[1-9][0-9]*$",
      "maxLength": 128
    },
    "policy_binding": {
      "type": "object",
      "required": [
        "policy_type",
        "policy_id",
        "policy_version",
        "policy_artifact_identity_sha256",
        "policy_content_identity_sha256",
        "policy_schema_identity_sha256",
        "policy_contract_identity_sha256"
      ],
      "properties": {
        "policy_type": {"const": "source_authority_policy"},
        "policy_id": {"const": "ltetf_source_authority_policy"},
        "policy_version": {"$ref": "#/$defs/version"},
        "policy_artifact_identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy_content_identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy_schema_identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy_contract_identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "repository_path_locator": {
      "type": "object",
      "required": ["locator_kind", "repository_relative_path"],
      "properties": {
        "locator_kind": {"const": "repository_path"},
        "repository_relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\x01-\\x5B\\x5D-\\x7F]+$",
          "allOf": [
            {"not": {"pattern": "^/"}},
            {"not": {"pattern": "^[A-Za-z]:"}},
            {"not": {"pattern": "//"}},
            {"not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}},
            {"not": {"pattern": "/$"}}
          ]
        }
      },
      "additionalProperties": false
    },
    "https_origin_locator": {
      "type": "object",
      "required": ["locator_kind", "scheme", "host_ascii", "port", "path_prefix"],
      "properties": {
        "locator_kind": {"const": "https_origin"},
        "scheme": {"const": "https"},
        "host_ascii": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
        },
        "port": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 65535, "not": {"const": 443}}
          ]
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^/(?:[A-Za-z0-9._~!$&'()*+,;=:@%-]+(?:/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)*)?$"
        }
      },
      "additionalProperties": false
    },
    "opaque_source_id_locator": {
      "type": "object",
      "required": ["locator_kind", "namespace", "opaque_id"],
      "properties": {
        "locator_kind": {"const": "opaque_source_id"},
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "opaque_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$"
        }
      },
      "additionalProperties": false
    },
    "source_locator": {
      "oneOf": [
        {"$ref": "#/$defs/repository_path_locator"},
        {"$ref": "#/$defs/https_origin_locator"},
        {"$ref": "#/$defs/opaque_source_id_locator"}
      ]
    },
    "source_record": {
      "type": "object",
      "required": [
        "source_id",
        "source_identity_profile_id",
        "source_class",
        "source_locator",
        "source_locator_identity_sha256",
        "authorized_evidence_classes",
        "source_record_identity_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._-]{0,127}$"
        },
        "source_identity_profile_id": {"const": "ltetf_source_identity_profile_v1"},
        "source_class": {"enum": ["operator_attested", "registered_external", "repository_derived"]},
        "source_locator": {"$ref": "#/$defs/source_locator"},
        "source_locator_identity_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_evidence_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trusted_evaluation_epoch",
              "structured_market_metrics",
              "structured_scheduled_events",
              "prior_thesis_continuity"
            ]
          }
        },
        "source_record_identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "policy_content": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version",
        "policy_schema_identity_sha256",
        "policy_contract_identity_sha256",
        "source_authority_policy_binding",
        "sources"
      ],
      "properties": {
        "policy_id": {"const": "ltetf_authorized_source_registry"},
        "policy_version": {"$ref": "#/$defs/version"},
        "policy_schema_identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy_contract_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_authority_policy_binding": {"$ref": "#/$defs/policy_binding"},
        "sources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/source_record"}
        }
      },
      "additionalProperties": false
    }
  }
}
